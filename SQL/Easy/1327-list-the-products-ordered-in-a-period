/*
    # 1327. List the Products Ordered in a Period
    # Difficulty: Easy
    # Link: https://leetcode.com/problems/list-the-products-ordered-in-a-period/
    # Topics: JOIN, GROUP BY, HAVING, DATE_FORMAT

    # Problem:
    Find the names of products that have at least 100 units ordered in February 2020.

    # Schema:
    Products (product_id int, product_name varchar, product_category varchar)
    Orders (product_id int, order_date date, unit int)
*/

SELECT 
    p.product_name,
    SUM(o.unit) AS unit
FROM Products p
JOIN Orders o ON p.product_id = o.product_id
WHERE DATE_FORMAT(o.order_date, '%Y-%m') = '2020-02'
GROUP BY p.product_name
HAVING SUM(o.unit) >= 100;
