/*
    # 1141. User Activity for the Past 30 Days I
    # Difficulty: Easy
    # Link: https://leetcode.com/problems/user-activity-for-the-past-30-days-i/
    # Topics: WHERE, COUNT DISTINCT, DATE_SUB, BETWEEN

    # Problem:
    Find the daily active user count for a period of 30 days 
    ending 2019-07-27 inclusively.

    # Schema:
    Activity (user_id int, session_id int, activity_date date, activity_type enum)
*/

SELECT 
    activity_date AS day,
    COUNT(DISTINCT user_id) AS active_users
FROM Activity
WHERE activity_date BETWEEN DATE_SUB('2019-07-27', INTERVAL 29 DAY) AND '2019-07-27'
GROUP BY day;
