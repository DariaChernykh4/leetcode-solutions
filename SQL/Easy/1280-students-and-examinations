/*
    # 1280. Students and Examinations
    # Difficulty: Easy
    # Link: https://leetcode.com/problems/students-and-examinations/
    # Topics: CROSS JOIN, LEFT JOIN, GROUP BY

    # Problem:
    Find the number of times each student attended each exam.
    Return all students and all subjects, even if the student didn't take that exam.

    # Schema:
    Students (student_id int, student_name varchar)
    Subjects (subject_name varchar)
    Examinations (student_id int, subject_name varchar)

    # Note:
    Need CROSS JOIN to generate all student-subject combinations first.
*/

SELECT 
    s.student_id,
    s.student_name,
    sub.subject_name,
    COUNT(e.subject_name) AS attended_exams
FROM Students s
CROSS JOIN Subjects sub
LEFT JOIN Examinations e 
    ON s.student_id = e.student_id 
    AND sub.subject_name = e.subject_name
GROUP BY s.student_id, s.student_name, sub.subject_name
ORDER BY s.student_id, sub.subject_name;
