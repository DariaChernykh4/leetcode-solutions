/*
    # 184. Department Highest Salary
    # Difficulty: Medium
    # Link: https://leetcode.com/problems/department-highest-salary
    # Topics: Window Functions, RANK, CTE, JOIN

    # Problem:
    Find employees who have the highest salary in each department.

    # Schema:
    Employee (id int, name varchar, salary int, departmentId int)
    Department (id int, name varchar)
*/

WITH ranked AS(
    SELECT 
        d.name AS Department,
        e.name AS Employee,
        e.salary AS Salary,
        RANK() OVER(PARTITION BY d.name ORDER BY e.salary DESC) AS rnk
    FROM Employee AS e
    JOIN Department AS d
        ON e.departmentId = d.id
)

SELECT
    Department,
    Employee,
    Salary
FROM ranked
WHERE rnk = 1;
