/*
    # 585. Investments in 2016
    # Difficulty: Medium
    # Link: https://leetcode.com/problems/investments-in-2016
    # Topics: Subquery, Aggregation, Conditional Filtering

    # Problem:
    Find the sum of tiv_2016 for policyholders who:
    1. Have the same tiv_2015 value as at least one other policyholder
    2. Are located in a unique city (lat, lon pair appears only once)

    # Schema:
    Insurance (pid int, tiv_2015 float, tiv_2016 float, lat float, lon float)
*/

SELECT 
    ROUND(SUM(tiv_2016), 2) AS tiv_2016
FROM Insurance
WHERE tiv_2015 IN (
    SELECT tiv_2015
    FROM Insurance
    GROUP BY tiv_2015
    HAVING COUNT(*) > 1
) 
AND (lat, lon) IN (
    SELECT lat, lon
    FROM Insurance
    GROUP BY lat, lon
    HAVING COUNT(*) = 1
);
