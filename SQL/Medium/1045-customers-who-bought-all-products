/*
    # 1045. Customers Who Bought All Products
    # Difficulty: Medium
    # Link: https://leetcode.com/problems/customers-who-bought-all-products/
    # Topics: GROUP BY, HAVING, Subquery

    # Problem:
    Find the customers who have bought ALL products in the Product table.

    # Schema:
    Customer (customer_id int, product_key int)
    Product (product_key int)
*/

SELECT customer_id
FROM Customer
GROUP BY customer_id
HAVING COUNT(DISTINCT product_key) = (SELECT COUNT(*) FROM Product);
