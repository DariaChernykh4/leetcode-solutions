/*
    # 1341. Movie Rating
    # Difficulty: Medium
    # Link: https://leetcode.com/problems/movie-rating/
    # Topics: UNION ALL, GROUP BY, ORDER BY, LIMIT

    # Problem:
    - Find the name of the user who has rated the greatest number of movies.
      In case of a tie, return the lexicographically smaller name.
    - Find the movie name with the highest average rating in February 2020.
      In case of a tie, return the lexicographically smaller movie name.

    # Schema:
    Movies (movie_id int, title varchar)
    Users (user_id int, name varchar)
    MovieRating (movie_id int, user_id int, rating int, created_at date)
*/

(SELECT u.name AS results
FROM MovieRating AS mr
JOIN Users AS u
    ON mr.user_id = u.user_id
GROUP BY u.name
ORDER BY COUNT(mr.user_id) DESC, u.name ASC
LIMIT 1)

UNION ALL

(SELECT m.title AS results
FROM MovieRating AS mr
JOIN Movies AS m
    ON mr.movie_id = m.movie_id
WHERE DATE_FORMAT(mr.created_at, '%Y-%m') = '2020-02'
GROUP BY m.title
ORDER BY AVG(rating) DESC, m.title ASC
LIMIT 1);
